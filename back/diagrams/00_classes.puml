namespace builder {
    class "StudentBuilder" << (S,Aquamarine) >> {
        - studyYear string

        + WithLastName(lastName string) *StudentBuilder
        + WithFirstName(firstName string) *StudentBuilder
        + WithLogin(login string) *StudentBuilder
        + WithPassword(password string) *StudentBuilder
        + WithEmail(email string) *StudentBuilder
        + WithPhoneNumber(phone string) *StudentBuilder
        + WithDepositBalance(balance float64) *StudentBuilder
        + WithBirthDate(date time.Time) *StudentBuilder
        + WithAddressId(id int) *StudentBuilder
        + WithStudyYear(year string) *StudentBuilder
        + Build() *models.Student

    }
    class "TeacherBuilder" << (S,Aquamarine) >> {
        - department *models.Department

        + WithLastName(lastName string) *TeacherBuilder
        + WithFirstName(firstName string) *TeacherBuilder
        + WithLogin(login string) *TeacherBuilder
        + WithPassword(password string) *TeacherBuilder
        + WithEmail(email string) *TeacherBuilder
        + WithPhoneNumber(phone string) *TeacherBuilder
        + WithDepositBalance(balance float64) *TeacherBuilder
        + WithBirthDate(date time.Time) *TeacherBuilder
        + WithAddressId(id int) *TeacherBuilder
        + WithDepartment(dept *models.Department) *TeacherBuilder
        + Build() *models.Teacher

    }
    class "UserBuilder" << (S,Aquamarine) >> {
        - u models.User

        + WithLastName(lastName string) *UserBuilder
        + WithFirstName(firstName string) *UserBuilder
        + WithLogin(login string) *UserBuilder
        + WithPassword(password string) *UserBuilder
        + WithEmail(email string) *UserBuilder
        + WithPhoneNumber(phone string) *UserBuilder
        + WithDepositBalance(balance float64) *UserBuilder
        + WithBirthDate(date time.Time) *UserBuilder
        + WithAddressId(id int) *UserBuilder
        + Build() *models.User

    }
}
